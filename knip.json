{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [".claude/hooks/*.mjs", "probes/t1-packaging/smoke.mjs"]
    },
    "apps/api": {
      "entry": ["src/main.ts", "src/import.ts", "src/admin.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/web": {
      "entry": ["test/**/*.test.tsx"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    }
  }
}
